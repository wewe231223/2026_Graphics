{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PipelineStateObject Schema",
  "description": "PSO JSON 값 사전",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "number" },
    "Name": { "type": "string" },
    "Type": { "enum": [ "Graphics", "Compute" ] },
    "RootSignature": { "type": "string" },
    "VS": { "$ref": "#/definitions/ShaderStage" },
    "PS": { "$ref": "#/definitions/ShaderStage" },
    "DS": { "$ref": "#/definitions/ShaderStage" },
    "HS": { "$ref": "#/definitions/ShaderStage" },
    "GS": { "$ref": "#/definitions/ShaderStage" },
    "CS": { "$ref": "#/definitions/ShaderStage" },
    "InputLayout": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "SemanticName": { "type": "string" },
          "SemanticIndex": { "type": "integer" },
          "Format": {
            "enum": [
              "UNKNOWN",
              "R32G32B32A32_TYPELESS",
              "R32G32B32A32_FLOAT",
              "R32G32B32A32_UINT",
              "R32G32B32A32_SINT",
              "R32G32B32_TYPELESS",
              "R32G32B32_FLOAT",
              "R32G32B32_UINT",
              "R32G32B32_SINT",
              "R16G16B16A16_TYPELESS",
              "R16G16B16A16_FLOAT",
              "R16G16B16A16_UNORM",
              "R16G16B16A16_UINT",
              "R16G16B16A16_SNORM",
              "R16G16B16A16_SINT",
              "R32G32_TYPELESS",
              "R32G32_FLOAT",
              "R32G32_UINT",
              "R32G32_SINT",
              "R32G8X24_TYPELESS",
              "D32_FLOAT_S8X24_UINT",
              "R32_FLOAT_X8X24_TYPELESS",
              "X32_TYPELESS_G8X24_UINT",
              "R10G10B10A2_TYPELESS",
              "R10G10B10A2_UNORM",
              "R10G10B10A2_UINT",
              "R11G11B10_FLOAT",
              "R8G8B8A8_TYPELESS",
              "R8G8B8A8_UNORM",
              "R8G8B8A8_UNORM_SRGB",
              "R8G8B8A8_UINT",
              "R8G8B8A8_SNORM",
              "R8G8B8A8_SINT",
              "R16G16_TYPELESS",
              "R16G16_FLOAT",
              "R16G16_UNORM",
              "R16G16_UINT",
              "R16G16_SNORM",
              "R16G16_SINT",
              "R32_TYPELESS",
              "D32_FLOAT",
              "R32_FLOAT",
              "R32_UINT",
              "R32_SINT",
              "R24G8_TYPELESS",
              "D24_UNORM_S8_UINT",
              "R24_UNORM_X8_TYPELESS",
              "X24_TYPELESS_G8_UINT",
              "R8G8_TYPELESS",
              "R8G8_UNORM",
              "R8G8_UINT",
              "R8G8_SNORM",
              "R8G8_SINT",
              "R16_TYPELESS",
              "R16_FLOAT",
              "D16_UNORM",
              "R16_UNORM",
              "R16_UINT",
              "R16_SNORM",
              "R16_SINT",
              "R8_TYPELESS",
              "R8_UNORM",
              "R8_UINT",
              "R8_SNORM",
              "R8_SINT",
              "A8_UNORM",
              "R1_UNORM",
              "R9G9B9E5_SHAREDEXP",
              "R8G8_B8G8_UNORM",
              "G8R8_G8B8_UNORM",
              "BC1_TYPELESS",
              "BC1_UNORM",
              "BC1_UNORM_SRGB",
              "BC2_TYPELESS",
              "BC2_UNORM",
              "BC2_UNORM_SRGB",
              "BC3_TYPELESS",
              "BC3_UNORM",
              "BC3_UNORM_SRGB",
              "BC4_TYPELESS",
              "BC4_UNORM",
              "BC4_SNORM",
              "BC5_TYPELESS",
              "BC5_UNORM",
              "BC5_SNORM",
              "B5G6R5_UNORM",
              "B5G5R5A1_UNORM",
              "B8G8R8A8_UNORM",
              "B8G8R8X8_UNORM",
              "R10G10B10_XR_BIAS_A2_UNORM",
              "B8G8R8A8_TYPELESS",
              "B8G8R8A8_UNORM_SRGB",
              "B8G8R8X8_TYPELESS",
              "B8G8R8X8_UNORM_SRGB",
              "BC6H_TYPELESS",
              "BC6H_UF16",
              "BC6H_SF16",
              "BC7_TYPELESS",
              "BC7_UNORM",
              "BC7_UNORM_SRGB",
              "AYUV",
              "Y410",
              "Y416",
              "NV12",
              "P010",
              "P016",
              "420_OPAQUE",
              "YUY2",
              "Y210",
              "Y216",
              "NV11",
              "AI44",
              "IA44",
              "P8",
              "A8P8",
              "B4G4R4A4_UNORM",
              "P208",
              "V208",
              "V408",
              "SAMPLER_FEEDBACK_MIN_MIP_OPAQUE",
              "SAMPLER_FEEDBACK_MIP_REGION_USED_OPAQUE"
            ]
          },
          "InputSlot": { "type": "integer" },
          "AlignedByteOffset": {
            "oneOf": [
              { "type": "integer" },
              { "const": 4294967295 }
            ]
          },
          "InputSlotClass": { "enum": [ "PerVertexData", "PerInstanceData" ] },
          "InstanceDataStepRate": { "type": "integer" }
        }
      }
    },
    "StreamOutput": {
      "type": "object",
      "properties": {
        "Entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "Stream": { "type": "integer" },
              "SemanticName": { "type": "string" },
              "SemanticIndex": { "type": "integer" },
              "StartComponent": { "type": "integer" },
              "ComponentCount": { "type": "integer" },
              "OutputSlot": { "type": "integer" }
            }
          }
        },
        "BufferStrides": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    },
    "BlendState": {
      "type": "object",
      "properties": {
        "AlphaToCoverageEnable": { "type": "boolean" },
        "IndependentBlendEnable": { "type": "boolean" },
        "RenderTargets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "BlendEnable": { "type": "boolean" },
              "LogicOpEnable": { "type": "boolean" },
              "SrcBlend": { "$ref": "#/definitions/BlendFactor" },
              "DestBlend": { "$ref": "#/definitions/BlendFactor" },
              "BlendOp": { "$ref": "#/definitions/BlendOp" },
              "SrcBlendAlpha": { "$ref": "#/definitions/BlendFactor" },
              "DestBlendAlpha": { "$ref": "#/definitions/BlendFactor" },
              "BlendOpAlpha": { "$ref": "#/definitions/BlendOp" },
              "LogicOp": { "$ref": "#/definitions/LogicOp" },
              "RenderTargetWriteMask": { "type": "integer" }
            }
          }
        }
      }
    },
    "SampleMask": { "type": "integer" },
    "RasterizerState": {
      "type": "object",
      "properties": {
        "FillMode": { "enum": [ "Solid", "Wireframe" ] },
        "CullMode": { "enum": [ "None", "Front", "Back" ] },
        "FrontCounterClockwise": { "type": "boolean" },
        "DepthBias": { "type": "integer" },
        "DepthBiasClamp": { "type": "number" },
        "SlopeScaledDepthBias": { "type": "number" },
        "DepthClipEnable": { "type": "boolean" },
        "MultisampleEnable": { "type": "boolean" },
        "AntialiasedLineEnable": { "type": "boolean" },
        "ForcedSampleCount": { "type": "integer" },
        "ConservativeRaster": { "enum": [ "Off", "On" ] }
      }
    },
    "DepthStencilState": {
      "type": "object",
      "properties": {
        "DepthEnable": { "type": "boolean" },
        "DepthWriteMask": { "enum": [ "Zero", "All" ] },
        "DepthFunc": { "$ref": "#/definitions/ComparisonFunc" },
        "StencilEnable": { "type": "boolean" },
        "StencilReadMask": { "type": "integer" },
        "StencilWriteMask": { "type": "integer" },
        "FrontFace": { "$ref": "#/definitions/DepthStencilOpDesc" },
        "BackFace": { "$ref": "#/definitions/DepthStencilOpDesc" }
      }
    },
    "IBStripCutValue": { "enum": [ "Disabled", "0xFFFF", "0xFFFFFFFF" ] },
    "PrimitiveTopologyType": { "enum": [ "Undefined", "Point", "Line", "Triangle", "Patch" ] },
    "RTVFormats": {
      "type": "array",
      "items": { "type": "string" }
    },
    "DSVFormat": { "type": "string" },
    "SampleDesc": {
      "type": "object",
      "properties": {
        "Count": { "type": "integer" },
        "Quality": { "type": "integer" }
      }
    },
    "NodeMask": { "type": "integer" },
    "Flags": {
      "type": "array",
      "items": { "enum": [ "ToolDebug" ] }
    }
  },
  "definitions": {
    "ShaderStage": {
      "type": "object",
      "properties": {
        "Source": { "type": "string" },
        "Identifier": { "type": "string" }
      }
    },
    "BlendFactor": {
      "enum": [ "One", "Zero", "SrcColor", "InvSrcColor", "SrcAlpha", "InvSrcAlpha", "DestAlpha", "InvDestAlpha", "DestColor", "InvDestColor", "SrcAlphaSat", "BlendFactor", "InvBlendFactor", "Src1Color", "InvSrc1Color", "Src1Alpha", "InvSrc1Alpha" ]
    },
    "BlendOp": {
      "enum": [ "Add", "Subtract", "RevSubtract", "Min", "Max" ]
    },
    "LogicOp": {
      "enum": [ "Clear", "Set", "Copy", "CopyInverted", "Noop", "Invert", "And", "Nand", "Or", "Nor", "Xor", "Equiv", "AndReverse", "AndInverted", "OrReverse", "OrInverted" ]
    },
    "ComparisonFunc": {
      "enum": [ "Never", "Less", "Equal", "LessEqual", "Greater", "NotEqual", "GreaterEqual", "Always" ]
    },
    "DepthStencilOpDesc": {
      "type": "object",
      "properties": {
        "StencilFailOp": { "$ref": "#/definitions/StencilOp" },
        "StencilDepthFailOp": { "$ref": "#/definitions/StencilOp" },
        "StencilPassOp": { "$ref": "#/definitions/StencilOp" },
        "StencilFunc": { "$ref": "#/definitions/ComparisonFunc" }
      }
    },
    "StencilOp": {
      "enum": [ "Keep", "Zero", "Replace", "IncrSat", "DecrSat", "Invert", "Incr", "Decr" ]
    }
  }
}